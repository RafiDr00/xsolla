# ---- Required -------------------------------------------------------------
# Bearer token clients must present on every /v1 route. This is the token you
# hand to the graders at submission. Generate something unguessable, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN=replace-me-with-a-long-random-token

# ---- Optional -------------------------------------------------------------
# HTTP port. Most hosts inject this themselves.
PORT=8080

# Where finished jobs and cached results are snapshotted, so a process restart
# inside the scoring window does not lose them. Unset = pure in-memory.
JOB_STORE_PATH=./data/jobs.json

# ---- LLM provider (Groq, OpenAI-compatible Chat Completions) --------------
# Required only for options.provider = "llm". If unset, the service still runs
# and serves "mock"; an "llm" job then fails gracefully with a clear error.
# Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=
# The base URL already includes Groq's /openai/v1 prefix; the provider appends
# /chat/completions to it.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_MS=20000
